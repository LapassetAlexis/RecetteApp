# Variables d'environnement pour le Menu Planner
# Copie ce fichier en .env et complète les valeurs

# Notion
NOTION_TOKEN=ntn_...
# ID de la base de recettes (optionnel : la base du projet par défaut)
# NOTION_DATABASE_ID=

# Provider LLM (import et enrichissement des recettes) :
# "ollama" (défaut, local), "gemini" ou "groq" (cloud, rapide)
LLM_PROVIDER=ollama

# Si LLM_PROVIDER=ollama (sert aussi de repli si le provider cloud tombe)
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b

# Si LLM_PROVIDER=gemini (obtenir une clé sur https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.0-flash-001

# Si LLM_PROVIDER=groq (obtenir une clé sur https://console.groq.com/keys)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.1-8b-instant

# App
APP_TITLE=Menu Planner Tristabeau
# Clé de signature des sessions. Laisse vide pour en générer une au démarrage
# (les sessions sont alors perdues à chaque redémarrage).
SECRET_KEY=

# Connexion optionnelle (formulaire de login, session de 30 jours) :
# renseigne les deux pour protéger l'app, laisse les deux vides pour un accès libre.
AUTH_USER=
AUTH_PASSWORD=

# Fichier SQLite. Dans le conteneur : /data/app_recettes.db (défaut).
# En local hors Docker : DATABASE_PATH=./dev.db
# DATABASE_PATH=
